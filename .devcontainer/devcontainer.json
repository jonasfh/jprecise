{
  "name": "JPrecise Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/jprecise",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/jprecise,type=bind,consistency=cached",
  "settings": {},
  "extensions": [
    "vscjava.vscode-java-pack"
  ],
  "postCreateCommand": "./gradlew --version || true",
  "remoteUser": "dev"
}
